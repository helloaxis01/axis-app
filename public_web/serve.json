{
  "rewrites": [
    { "source": "/onboarding/", "destination": "/onboarding.html" },
    { "source": "/onboarding", "destination": "/onboarding.html" }
  ],
  "headers": [
    {
      "source": "**/*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}
