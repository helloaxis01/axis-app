  "description": "AXIS web shell (public_web). Vercel: static output from public_web/; npm run build is a no-op. Use npm run verify (and npm run bump-cache before release) locally.",
  "scripts": {
    "build": "exit 0",
    "bump-cache": "node scripts/bump-cache.cjs",
    "verify": "node scripts/verify-inline-syntax.cjs",
